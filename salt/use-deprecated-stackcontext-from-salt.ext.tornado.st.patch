From 08b9dd73341b94b335d1cead4777ebd9c60f1584 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Pablo=20Su=C3=A1rez=20Hern=C3=A1ndez?=
 <psuarezhernandez@suse.com>
Date: Wed, 30 Jul 2025 16:26:21 +0100
Subject: [PATCH] Use deprecated StackContext from
 salt.ext.tornado.stack_context

---
 salt/metaproxy/deltaproxy.py | 3 ++-
 salt/metaproxy/proxy.py      | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/salt/metaproxy/deltaproxy.py b/salt/metaproxy/deltaproxy.py
index 4c07236d34..dee46fa262 100644
--- a/salt/metaproxy/deltaproxy.py
+++ b/salt/metaproxy/deltaproxy.py
@@ -22,6 +22,7 @@ import salt.config
 import salt.crypt
 import salt.defaults.exitcodes
 import salt.engines
+import salt.ext.tornado.stack_context # pylint: disable=F0401
 import salt.loader
 import salt.minion
 import salt.payload
@@ -562,7 +563,7 @@ def target(cls, minion_instance, opts, data, connected):
         uid = salt.utils.user.get_uid(user=opts.get("user", None))
         minion_instance.proc_dir = salt.minion.get_proc_dir(opts["cachedir"], uid=uid)
 
-    with tornado.stack_context.StackContext(minion_instance.ctx):
+    with salt.ext.tornado.stack_context.StackContext(minion_instance.ctx):
         if isinstance(data["fun"], tuple) or isinstance(data["fun"], list):
             ProxyMinion._thread_multi_return(minion_instance, opts, data)
         else:
diff --git a/salt/metaproxy/proxy.py b/salt/metaproxy/proxy.py
index 161ccfc230..10ace0f090 100644
--- a/salt/metaproxy/proxy.py
+++ b/salt/metaproxy/proxy.py
@@ -18,6 +18,7 @@ import salt.defaults.exitcodes
 import salt.engines
 import tornado.gen  # pylint: disable=F0401
 import tornado.ioloop  # pylint: disable=F0401
+import salt.ext.tornado.stack_context # pylint: disable=F0401
 import salt.loader
 import salt.minion
 import salt.payload
@@ -380,7 +381,7 @@ def target(cls, minion_instance, opts, data, connected):
                 opts["cachedir"], uid=uid
             )
 
-    with tornado.stack_context.StackContext(minion_instance.ctx):
+    with salt.ext.tornado.stack_context.StackContext(minion_instance.ctx):
         if isinstance(data["fun"], tuple) or isinstance(data["fun"], list):
             ProxyMinion._thread_multi_return(minion_instance, opts, data)
         else:
